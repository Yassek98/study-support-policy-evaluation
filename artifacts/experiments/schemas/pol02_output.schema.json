{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.thesis.invalid/schemas/pol02_output.schema.json",
  "title": "POL-02 Graded Scaffold Output Schema",
  "description": "Formal schema for the observable response and decision trace of POL-02 (Graded Scaffolding).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "policy_id",
    "policy_version",
    "timestamp",
    "system_response",
    "decision_trace",
    "policy_activated",
    "non_activation_reason",
    "level_before",
    "level_after",
    "transition",
    "transition_reason",
    "user_signal",
    "support_move",
    "orientation_question",
    "declared_options_used",
    "process_structure",
    "grounded_facts_used",
    "pol03_delegation_requested",
    "scaffold_state",
    "turn_status",
    "safety_violations"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^SCN-[A-Za-z0-9_.-]+$",
      "description": "Canonical identifier of the executed test scenario."
    },
    "configuration_context": {
      "type": "object",
      "properties": {
        "pol03_enabled": {
          "type": "boolean",
          "description": "Indicates whether POL-03 is enabled in the active configuration."
        }
      },
      "additionalProperties": false,
      "description": "Experimental configuration context of the session."
    },
    "policy_id": {
      "type": "string",
      "const": "POL-02_GRADED_SCAFFOLD",
      "description": "Canonical identifier of the graded scaffold policy."
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the policy contract."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the execution."
    },
    "system_response": {
      "type": "string",
      "minLength": 1,
      "description": "Text of the conversational response generated by the assistant."
    },
    "decision_trace": {
      "type": "array",
      "items": {
        "$ref": "trace_event.schema.json"
      },
      "minItems": 1,
      "description": "Trace of logical steps and state checks performed by POL-02."
    },
    "policy_activated": {
      "type": "boolean",
      "description": "True if the scaffolding policy activated during the turn; False otherwise."
    },
    "non_activation_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Explicit reason for non-activation when policy_activated is False."
    },
    "level_before": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 3,
      "description": "Previous support level (null in the initial turn)."
    },
    "level_after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Resulting support level after the decision."
    },
    "transition": {
      "type": "string",
      "enum": [
        "HOLD",
        "ESCALATE",
        "FADE",
        "RESET_TO_AUTONOMY",
        "STOP",
        "NOT_APPLICABLE"
      ],
      "description": "Applied level transition. Must be ESCALATE if level_after > level_before, HOLD if level_after == level_before, FADE if level_after < level_before, RESET_TO_AUTONOMY if reset to 0, STOP on user stop."
    },
    "transition_reason": {
      "type": "string",
      "enum": [
        "INITIAL_MINIMUM_SUPPORT",
        "USER_REQUESTED_ORIENTATION",
        "USER_DECLARED_PERSISTENT_STALL",
        "USER_REQUESTED_MORE_STRUCTURE",
        "USER_FORMULATED_OWN_NEXT_STEP",
        "USER_REQUESTED_INDEPENDENCE",
        "USER_ALREADY_AUTONOMOUS_PLAN",
        "USER_REFUSED_SUPPORT",
        "CONTENT_REQUEST_OUT_OF_SCOPE",
        "MISSING_OBSERVABLE_SIGNAL",
        "NO_TRANSITION_INITIAL"
      ],
      "description": "Reason for the level transition."
    },
    "user_signal": {
      "type": "string",
      "enum": [
        "NO_ASSISTANCE_REQUESTED",
        "ORIENTATION_REQUEST",
        "PERSISTENT_STALL",
        "MORE_HELP_REQUESTED",
        "AUTONOMY_RESUMED",
        "EXPLICIT_SELF_DIRECTION",
        "REFUSAL",
        "STOP_REQUEST",
        "CONTENT_QUESTION",
        "INSUFFICIENT_EVIDENCE"
      ],
      "description": "Observed user dialogue signal detected in the turn."
    },
    "support_move": {
      "type": "string",
      "enum": [
        "NONE",
        "AUTONOMY_INVITATION",
        "ASK_ORIENTATION_QUESTION",
        "OFFER_SELECTION_CRITERION",
        "OFFER_DECLARED_OPTIONS",
        "PROVIDE_PROCESS_STRUCTURE",
        "REQUEST_USER_DEFINED_ACTION",
        "DELEGATE_TO_POL03",
        "STOP_AND_ACKNOWLEDGE"
      ],
      "description": "Support move delivered in the turn."
    },
    "orientation_question": {
      "type": [
        "string",
        "null"
      ],
      "description": "Text of the single orientation question (required at Level 1, null at other levels)."
    },
    "declared_options_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 2,
      "description": "User-declared options offered at Level 2 (maximum 2 options)."
    },
    "process_structure": {
      "type": [
        "string",
        "null"
      ],
      "description": "Description of the procedural structure or decomposition offered at Level 2 or 3."
    },
    "grounded_facts_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "List of declared facts used to calibrate scaffolding."
    },
    "pol03_delegation_requested": {
      "type": "boolean",
      "description": "True if and only if an action proposal is requested from POL-03 (allowed only at Level 3)."
    },
    "scaffold_state": {
      "$ref": "scaffold_state.schema.json",
      "description": "Structured record of the persistent scaffolding state."
    },
    "turn_status": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "SUPPORT_DELIVERED",
        "PENDING_USER_RESPONSE",
        "PENDING_POL03",
        "AUTONOMY_RESUMED",
        "STOPPED"
      ],
      "description": "Operational turn status of POL-02."
    },
    "safety_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "severity",
          "description"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "List of detected safety or policy rule violations."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy_activated": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "non_activation_reason": {
            "type": "string",
            "minLength": 1
          },
          "turn_status": {
            "const": "NOT_APPLICABLE"
          },
          "support_move": {
            "const": "NONE"
          },
          "pol03_delegation_requested": {
            "const": false
          },
          "orientation_question": {
            "type": "null"
          },
          "declared_options_used": {
            "maxItems": 0
          },
          "process_structure": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "non_activation_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level_after": {
            "const": 1
          },
          "policy_activated": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "orientation_question": {
            "type": "string",
            "minLength": 1
          },
          "support_move": {
            "const": "ASK_ORIENTATION_QUESTION"
          },
          "pol03_delegation_requested": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level_after": {
            "enum": [
              0,
              2,
              3
            ]
          }
        }
      },
      "then": {
        "properties": {
          "orientation_question": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level_after": {
            "const": 3
          },
          "policy_activated": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "configuration_context"
        ],
        "properties": {
          "configuration_context": {
            "type": "object",
            "required": [
              "pol03_enabled"
            ],
            "properties": {
              "pol03_enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level_after": {
            "const": 3
          },
          "policy_activated": {
            "const": true
          },
          "configuration_context": {
            "properties": {
              "pol03_enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "pol03_delegation_requested": {
            "const": true
          },
          "support_move": {
            "const": "DELEGATE_TO_POL03"
          },
          "turn_status": {
            "const": "PENDING_POL03"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level_after": {
            "const": 3
          },
          "policy_activated": {
            "const": true
          },
          "configuration_context": {
            "properties": {
              "pol03_enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "pol03_delegation_requested": {
            "const": false
          },
          "support_move": {
            "const": "PROVIDE_PROCESS_STRUCTURE"
          },
          "turn_status": {
            "not": {
              "const": "PENDING_POL03"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pol03_delegation_requested": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "configuration_context"
        ],
        "properties": {
          "level_after": {
            "const": 3
          },
          "support_move": {
            "const": "DELEGATE_TO_POL03"
          },
          "turn_status": {
            "const": "PENDING_POL03"
          },
          "configuration_context": {
            "type": "object",
            "required": [
              "pol03_enabled"
            ],
            "properties": {
              "pol03_enabled": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "turn_status": {
            "const": "PENDING_POL03"
          }
        }
      },
      "then": {
        "properties": {
          "pol03_delegation_requested": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pol03_delegation_requested": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "turn_status": {
            "not": {
              "const": "PENDING_POL03"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "const": "STOP"
          }
        }
      },
      "then": {
        "properties": {
          "turn_status": {
            "const": "STOPPED"
          },
          "level_after": {
            "const": 0
          },
          "pol03_delegation_requested": {
            "const": false
          },
          "support_move": {
            "const": "STOP_AND_ACKNOWLEDGE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "const": "ESCALATE"
          }
        }
      },
      "then": {
        "properties": {
          "user_signal": {
            "enum": [
              "PERSISTENT_STALL",
              "MORE_HELP_REQUESTED",
              "ORIENTATION_REQUEST",
              "INSUFFICIENT_EVIDENCE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_activated": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "turn_status": {
            "enum": [
              "SUPPORT_DELIVERED",
              "PENDING_USER_RESPONSE",
              "PENDING_POL03",
              "AUTONOMY_RESUMED",
              "STOPPED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "configuration_context": {
            "properties": {
              "pol03_enabled": {
                "const": false
              }
            },
            "required": [
              "pol03_enabled"
            ]
          }
        },
        "required": [
          "configuration_context"
        ]
      },
      "then": {
        "properties": {
          "pol03_delegation_requested": {
            "const": false
          }
        }
      }
    }
  ]
}
