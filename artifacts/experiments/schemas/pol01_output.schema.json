{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.thesis.invalid/schemas/pol01_output.schema.json",
  "title": "POL-01 Observable Output",
  "description": "Structured schema representing the observable output record generated by applying POL-01_IF_THEN_PLAN in a conversational turn.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "policy_id",
    "policy_version",
    "policy_activated",
    "timestamp",
    "system_response",
    "violations",
    "decision_trace"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^SCN-[A-Z0-9_-]+$",
      "description": "Unique scenario identifier conforming to scenario.schema.json."
    },
    "policy_id": {
      "type": "string",
      "const": "POL-01_IF_THEN_PLAN"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "default": "0.1.0"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp or execution time marker."
    },
    "policy_activated": {
      "type": "boolean",
      "description": "true if the policy actively intervened during the turn, false otherwise."
    },
    "non_activation_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "no_planning_intent",
        "content_help_request",
        "emotional_support_request",
        "plan_already_confirmed",
        "user_refused_or_stopped",
        "general_information_request"
      ],
      "description": "Reason for non-activation, required when policy_activated is false."
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identified",
        "source",
        "specificity"
      ],
      "properties": {
        "identified": {
          "type": [
            "string",
            "null"
          ],
          "description": "Identified situational cue, or null if missing."
        },
        "source": {
          "type": "string",
          "enum": [
            "user_provided",
            "system_proposed_accepted",
            "missing"
          ]
        },
        "specificity": {
          "type": "string",
          "enum": [
            "specific",
            "vague",
            "missing"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identified",
        "source",
        "observability"
      ],
      "properties": {
        "identified": {
          "type": [
            "string",
            "null"
          ],
          "description": "Identified action, or null if missing."
        },
        "source": {
          "type": "string",
          "enum": [
            "user_provided",
            "pol03_accepted",
            "system_invented",
            "missing"
          ],
          "description": "'system_invented' records a non-invention violation."
        },
        "observability": {
          "type": "string",
          "enum": [
            "observable",
            "vague",
            "missing"
          ]
        }
      }
    },
    "missing_elements": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cue",
          "action",
          "objective"
        ]
      },
      "description": "Missing required elements requested from the user."
    },
    "clarification_requested": {
      "type": "boolean",
      "description": "true if the system explicitly requested clarification for missing or vague elements."
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formulated",
        "confirmation_status",
        "user_response"
      ],
      "properties": {
        "formulated": {
          "type": [
            "string",
            "null"
          ],
          "description": "The plan in the form 'When [cue], then [action]', or null if not formulated."
        },
        "confirmation_status": {
          "type": "string",
          "enum": [
            "confirmed",
            "modified",
            "rejected",
            "pending",
            "not_reached"
          ],
          "description": "Status of user confirmation."
        },
        "user_response": {
          "type": [
            "string",
            "null"
          ],
          "description": "User textual response or confirmation. Must be null when confirmation_status is pending."
        }
      }
    },
    "system_response": {
      "type": "string",
      "minLength": 1,
      "description": "Conversational response shown to the user."
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "forbidden_action",
          "severity",
          "evidence"
        ],
        "properties": {
          "forbidden_action": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      },
      "description": "List of forbidden action violations detected during the turn."
    },
    "decision_trace": {
      "type": "array",
      "items": {
        "$ref": "trace_event.schema.json"
      },
      "minItems": 1,
      "description": "Structured trace of decision events executed by POL-01."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy_activated": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "cue",
          "action",
          "plan",
          "clarification_requested"
        ],
        "properties": {
          "non_activation_reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "non_activation_reason"
        ],
        "properties": {
          "non_activation_reason": {
            "type": "string"
          }
        }
      }
    }
  ]
}
