{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.thesis.invalid/schemas/benchmark_quality.schema.json",
  "title": "Level B Quality Benchmark Specification",
  "description": "Schema per la specifica formale di un benchmark di qualità Level B (indipendente dalla policy e non circolare).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "version",
    "title",
    "evaluation_level",
    "construct_definition",
    "target_domains",
    "candidate_terminal_states",
    "dimensions",
    "safety_envelope_checks",
    "scoring_rules",
    "anti_circularity_constraints"
  ],
  "properties": {
    "benchmark_id": {
      "type": "string",
      "pattern": "^BENCH-[A-Z0-9_-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_level": {
      "type": "string",
      "const": "LEVEL_B_BENCHMARK_QUALITY"
    },
    "construct_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construct_name",
        "formal_definition",
        "operational_question",
        "scope_boundary"
      ],
      "properties": {
        "construct_name": {
          "type": "string"
        },
        "formal_definition": {
          "type": "string"
        },
        "operational_question": {
          "type": "string"
        },
        "scope_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "included",
            "excluded"
          ],
          "properties": {
            "included": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "target_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "candidate_terminal_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_id",
          "category",
          "description",
          "policy_agnostic_criterion"
        ],
        "properties": {
          "state_id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "positive",
              "neutral_stop",
              "negative",
              "critical_failure"
            ]
          },
          "description": {
            "type": "string"
          },
          "policy_agnostic_criterion": {
            "type": "string"
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "name",
          "question",
          "scale",
          "anchors"
        ],
        "properties": {
          "dimension_id": {
            "type": "string",
            "pattern": "^Q[0-9]_[A-Z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "scale": {
            "type": "string",
            "enum": [
              "ordinal_0_2"
            ]
          },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "0",
              "1",
              "2"
            ],
            "properties": {
              "0": {
                "type": "string"
              },
              "1": {
                "type": "string"
              },
              "2": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "safety_envelope_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "name",
          "severity",
          "criterion"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major"
            ]
          },
          "criterion": {
            "type": "string"
          }
        }
      }
    },
    "scoring_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation_mode",
        "pass_level_b_rule",
        "pass_rule_status",
        "non_compensation_principle"
      ],
      "properties": {
        "aggregation_mode": {
          "type": "string"
        },
        "pass_level_b_rule": {
          "type": "string"
        },
        "pass_rule_status": {
          "type": "string",
          "enum": [
            "CANDIDATE_UNCALIBRATED",
            "CALIBRATION_PROPOSED",
            "SUPERVISOR_REVIEWED",
            "FROZEN"
          ],
          "description": "Calibration status of the pass rule. CANDIDATE_UNCALIBRATED: present in spec but not supported by calibration evidence. FROZEN: only after the WP9 evidence and authority gates."
        },
        "non_compensation_principle": {
          "type": "string"
        }
      }
    },
    "anti_circularity_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint_id",
          "name",
          "description",
          "verification_method"
        ],
        "properties": {
          "constraint_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "verification_method": {
            "type": "string"
          }
        }
      }
    }
  }
}
