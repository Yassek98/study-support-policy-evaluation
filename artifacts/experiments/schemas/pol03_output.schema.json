{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.thesis.invalid/schemas/pol03_output.schema.json",
  "title": "POL-03 Output Trace Schema",
  "description": "Schema for the observable output and state record generated per turn by policy POL-03 (Accepted Next Action), including execution provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "policy_id",
    "policy_version",
    "timestamp",
    "system_response",
    "decision_trace",
    "policy_activated",
    "non_activation_reason",
    "clarification_requested",
    "clarification_prompt",
    "proposed_action",
    "action_count",
    "action_observability",
    "grounded_facts_used",
    "action_record",
    "pol01_handoff_ready",
    "user_evidence_recorded",
    "turn_status",
    "safety_violations"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^SCN-[A-Z0-9_-]+$",
      "description": "Unique scenario identifier conforming to scenario.schema.json."
    },
    "policy_id": {
      "type": "string",
      "const": "POL-03_ACCEPTED_NEXT_ACTION",
      "description": "Canonical policy identifier."
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "default": "0.1.0",
      "description": "Semantic version of the policy contract."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp or turn execution time marker."
    },
    "system_response": {
      "type": "string",
      "description": "Actual text of the response generated by the system and shown to the user."
    },
    "decision_trace": {
      "type": "array",
      "items": {
        "$ref": "trace_event.schema.json"
      },
      "minItems": 1,
      "description": "Ordered trace of decision steps and checks executed during the turn."
    },
    "policy_activated": {
      "type": "boolean",
      "description": "Indicates whether POL-03 activated in the current turn."
    },
    "non_activation_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "content_request",
        "already_accepted_action",
        "user_refused_or_stopped",
        "missing_objective",
        "general_dialogue",
        "autonomous_action_already_provided"
      ],
      "description": "Reason for non-activation (required when policy_activated is false)."
    },
    "clarification_requested": {
      "type": "boolean",
      "description": "Indicates whether the system requested targeted clarification regarding materials or context."
    },
    "clarification_prompt": {
      "type": [
        "string",
        "null"
      ],
      "description": "Text of the clarification prompt addressed to the user."
    },
    "proposed_action": {
      "type": [
        "string",
        "null"
      ],
      "description": "Textual formulation of the single proposed action."
    },
    "action_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "Number of candidate actions proposed in the turn (exactly 1 if proposed_action is present; 0 if absent or during clarification/stop)."
    },
    "action_observability": {
      "type": "string",
      "enum": [
        "observable",
        "vague",
        "missing"
      ],
      "description": "Behavioral observability level of the proposed action."
    },
    "grounded_facts_used": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Facts explicitly declared by the user used to formulate the action."
    },
    "action_record": {
      "$ref": "action_record.schema.json",
      "description": "Shared structured action record."
    },
    "pol01_handoff_ready": {
      "type": "boolean",
      "description": "True if and only if the action is in ACTION_ACCEPTED status with version == accepted_version, ready to be consumed by POL-01."
    },
    "user_evidence_recorded": {
      "type": [
        "string",
        "null"
      ],
      "description": "Explicit evidence of user acceptance or confirmation."
    },
    "turn_status": {
      "type": "string",
      "enum": [
        "PENDING_CLARIFICATION",
        "ACTION_PROPOSED_PENDING_CONFIRMATION",
        "ACTION_ACCEPTED",
        "ACTION_REJECTED",
        "STOPPED",
        "NOT_APPLICABLE"
      ],
      "description": "Operational status reached in the current turn."
    },
    "safety_violations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "S1_AUTONOMY_VIOLATION",
          "S2_UNGROUNDED_INVENTION",
          "S3_UNVERIFIED_ACCEPTANCE",
          "S4_DIAGNOSTIC_IMPOSITION"
        ]
      },
      "description": "Any critical safety violations detected during the turn."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy_activated": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "non_activation_reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "non_activation_reason"
        ],
        "properties": {
          "non_activation_reason": {
            "type": "string",
            "minLength": 3
          },
          "proposed_action": {
            "type": "null"
          },
          "action_count": {
            "const": 0
          },
          "pol01_handoff_ready": {
            "const": false
          },
          "turn_status": {
            "const": "NOT_APPLICABLE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pol01_handoff_ready": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "turn_status": {
            "const": "ACTION_ACCEPTED"
          }
        }
      },
      "else": {
        "not": {
          "properties": {
            "turn_status": {
              "const": "ACTION_ACCEPTED"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposed_action": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "action_count": {
            "const": 1
          }
        }
      },
      "else": {
        "properties": {
          "action_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "clarification_requested": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "clarification_prompt": {
            "type": "string",
            "minLength": 1
          },
          "turn_status": {
            "const": "PENDING_CLARIFICATION"
          }
        }
      },
      "else": {
        "properties": {
          "clarification_prompt": {
            "type": "null"
          }
        },
        "not": {
          "properties": {
            "turn_status": {
              "const": "PENDING_CLARIFICATION"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "turn_status": {
            "const": "ACTION_PROPOSED_PENDING_CONFIRMATION"
          }
        }
      },
      "then": {
        "properties": {
          "action_record": {
            "properties": {
              "action_status": {
                "const": "ACTION_PROPOSED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "turn_status": {
            "const": "ACTION_ACCEPTED"
          }
        }
      },
      "then": {
        "properties": {
          "action_record": {
            "properties": {
              "action_status": {
                "const": "ACTION_ACCEPTED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "turn_status": {
            "const": "ACTION_REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "action_record": {
            "properties": {
              "action_status": {
                "const": "ACTION_REJECTED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "turn_status": {
            "const": "STOPPED"
          }
        }
      },
      "then": {
        "properties": {
          "action_record": {
            "properties": {
              "action_status": {
                "const": "STOPPED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "turn_status": {
            "const": "PENDING_CLARIFICATION"
          }
        }
      },
      "then": {
        "properties": {
          "action_record": {
            "properties": {
              "action_status": {
                "const": "CLARIFICATION_PENDING"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "turn_status": {
            "const": "NOT_APPLICABLE"
          }
        }
      },
      "then": {
        "properties": {
          "policy_activated": {
            "const": false
          },
          "action_record": {
            "properties": {
              "action_status": {
                "const": "NOT_APPLICABLE"
              }
            }
          }
        }
      }
    }
  ]
}
